# Copia este archivo a `.env` y descomenta lo que necesites.
#
# El `.env` NO se sube al repositorio: ya esta en .gitignore.
# Todos los valores tienen un default en src/inventory_ml/config.py, asi que
# solo hace falta descomentar lo que quieras cambiar.
#
# Las variables del entorno (las que pongas con $env: en PowerShell) tienen
# prioridad sobre este archivo.

# --- Datos y modelo ---
# DB_PATH=data/inventario.db
# MODEL_NAME=stockout_simulated_v1
# MODEL_PATH=artifacts/models/stockout_simulated_v1.joblib
# MODEL_METADATA_PATH=artifacts/models/stockout_simulated_v1.metadata.json

# --- Dominio ---
# HORIZONTE_DIAS=30
# LEAD_TIME_DIAS=30
# UMBRAL_RIESGO_ALTO=0.70
# UMBRAL_RIESGO_MEDIO=0.40

# --- API ---
# MAX_BATCH_SIZE=500

# --- Asistente LLM ---
# La clave va SIN comentar para que funcione. Nunca la subas al repositorio.
# LLM_API_KEY=pon-aqui-tu-clave
# Por defecto: Google Gemini (endpoint compatible con OpenAI). Clave en
# https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.5-flash-lite   (500/dia; los Flash solo dan 20/dia)
# Si el principal da 503/429 se prueban estos en orden (cuota por modelo):
# LLM_MODELOS_RESPALDO=gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3-flash-preview,gemini-flash-latest
# Groq: LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
# LLM_MAX_TOKENS=800
# LLM_TOP_RIESGO=15
